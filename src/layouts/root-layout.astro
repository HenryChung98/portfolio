---
import '../styles/global.css';
import { PROFILE } from '../consts';
import { getTranslations } from '../i18n';
import { getAbsoluteLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
const t = getTranslations(locale);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PROFILE.name,
  url: getAbsoluteLocaleUrl('en'),
  jobTitle: PROFILE.title,
  sameAs: [PROFILE.github, PROFILE.linkedin, PROFILE.blog],
  knowsAbout: ["JavaScript", "TypeScript", "React", "Next.js", "PostgreSQL"],
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/portfolio/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    	<title>{t.meta.title}</title>

		 <meta
      name="description"
      content={t.meta.description}
    />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl('en')} />
    <link rel="alternate" hreflang="ko" href={getAbsoluteLocaleUrl('ko')} />
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en')} />
    <meta name="author" content={PROFILE.name} />
    <meta name="theme-color" content="#d7d7da" />

    <!-- Open Graph tags -->
    <meta property="og:title" content={PROFILE.og.title} />
    <meta
      property="og:description"
      content={PROFILE.og.description}
    />
    <meta property="og:type" content={PROFILE.og.type} />
    <meta
      property="og:url"
      content={getAbsoluteLocaleUrl(locale)}
    />
    <meta
      property="og:image"
      content={new URL(PROFILE.og.image, Astro.site).href}
    />
    <meta
      property="og:image:alt"
      content={PROFILE.og.imageAlt}
    />
    <meta property="og:locale" content={t.meta.ogLocale} />

    <!-- poppins font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />
	</body>
</html>
